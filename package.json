{
  "name": "mtg-ecosystem",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:engine": "node scripts/check-engine.ts",
    "check:engine:source": "node scripts/check-engine.ts --source",
    "check:engine:contracts": "node scripts/check-engine.ts --contracts",
    "check:engine:full": "node scripts/check-engine.ts --full",
    "demo:engine": "cargo run --locked -p mtg-sim -- demo",
    "retain:engine": "node scripts/retain-engine-evidence.ts",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "ingest": "node scripts/ingest-scryfall.ts",
    "build-ir": "node scripts/build-ir.ts",
    "archive-parser": "node scripts/archive-parser.ts",
    "validate": "node scripts/validate-parser.ts",
    "retain:server": "node scripts/retain-server-evidence.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^26.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
