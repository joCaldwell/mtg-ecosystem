{
  "name": "mtg-ecosystem",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:docs": "python3 scripts/check-docs.py",
    "engine:bootstrap": "sh scripts/engine-bootstrap.sh",
    "engine:doctor": "sh scripts/engine-env.sh node scripts/engine-doctor.ts",
    "engine:dev": "sh scripts/engine-dev.sh",
    "engine:decks": "sh scripts/engine-env.sh python3 -B scripts/engine-decks.py",
    "check:engine": "sh scripts/engine-env.sh node scripts/check-engine.ts",
    "check:engine:gate": "sh scripts/engine-env.sh node scripts/check-engine.ts --gate",
    "check:engine:tooling": "sh scripts/engine-env.sh node scripts/check-engine.ts --tooling",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "ingest": "node scripts/ingest-scryfall.ts",
    "archive-parser": "node scripts/archive-parser.ts",
    "validate": "node scripts/validate-parser.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^26.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
