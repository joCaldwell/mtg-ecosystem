{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "tests/types.ts",
    "generated/**/*.d.ts"
  ]
}
