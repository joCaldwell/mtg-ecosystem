{
  "name": "@multiverse/game-server-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run build:browser && npm run typecheck && npm test",
    "verify": "node scripts/verify.mjs",
    "build:browser": "npm run generate && node scripts/build-browser.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "types": "./dist/browser.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false
}
