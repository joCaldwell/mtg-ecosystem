# Copy to .env (gitignored) and fill in.

# OpenRouter API key — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Model slug used by the deck agent. Swap freely; see https://openrouter.ai/models
# e.g. openai/gpt-5.6-sol-pro, anthropic/claude-opus-5, ...
OPENROUTER_MODEL=openai/gpt-5.6-sol

# Optional overrides
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#DECKBUILDER_PORT=8787
#DECKBUILDER_DB=/path/to/deck-builder.db
