{
  "name": "@mtg-ecosystem/deck-builder",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "launch": "node ../multiverse/scripts/serve.mjs launch",
    "install:launcher": "node ../multiverse/scripts/install-launcher.mjs",
    "uninstall:launcher": "node ../multiverse/scripts/install-launcher.mjs --uninstall",
    "start": "node ../multiverse/scripts/serve.mjs start",
    "stop": "node ../multiverse/scripts/serve.mjs stop",
    "restart": "node ../multiverse/scripts/serve.mjs restart",
    "status": "node ../multiverse/scripts/serve.mjs status",
    "logs": "node ../multiverse/scripts/serve.mjs logs",
    "dev": "node ../multiverse/scripts/dev.mjs",
    "check": "npm run build && npm test",
    "build": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "refresh": "node src/cli.ts refresh",
    "search": "node src/cli.ts search",
    "seed:demo": "node scripts/seed-demo.mjs",
    "app": "npm --prefix ../multiverse run app --workspaces=false",
    "dev:server": "node --watch ../multiverse/src/server.ts",
    "dev:web": "npm --prefix ../multiverse run dev:web --workspaces=false",
    "mcp": "node src/mcp/stdio.ts",
    "backup": "node src/cli.ts backup",
    "restore": "node src/cli.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@better-auth/cimd": "1.7.13",
    "@better-auth/core": "1.7.13",
    "@better-auth/kysely-adapter": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-auth": "1.7.13",
    "jose": "6.2.3",
    "kysely": "0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.12"
  },
  "exports": {
    "./host": "./src/host.ts",
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    }
  }
}
