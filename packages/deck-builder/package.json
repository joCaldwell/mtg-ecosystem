{
  "name": "@mtg-ecosystem/deck-builder",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "launch": "node scripts/serve.mjs launch",
    "install:launcher": "node scripts/install-launcher.mjs",
    "uninstall:launcher": "node scripts/install-launcher.mjs --uninstall",
    "start": "node scripts/serve.mjs start",
    "stop": "node scripts/serve.mjs stop",
    "restart": "node scripts/serve.mjs restart",
    "status": "node scripts/serve.mjs status",
    "logs": "node scripts/serve.mjs logs",
    "dev": "node scripts/dev.mjs",
    "check": "npm run build && npm test",
    "build": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "refresh": "node src/cli.ts refresh",
    "search": "node src/cli.ts search",
    "seed:demo": "node scripts/seed-demo.mjs",
    "app": "vite build && node src/server.ts",
    "dev:server": "node --watch src/server.ts",
    "dev:web": "vite",
    "mcp": "node src/mcp/stdio.ts",
    "backup": "node src/cli.ts backup",
    "restore": "node src/cli.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@better-auth/cimd": "1.7.13",
    "@better-auth/core": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-auth": "1.7.13",
    "jose": "6.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.12"
  }
}
